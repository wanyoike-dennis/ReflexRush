<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Preserve offline scores, audio preferences, statistics, and progression. -->
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Preserve player data when moving to a new Android device. -->
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
